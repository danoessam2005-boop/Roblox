-- Funأ§أ£o para criar botأµes
local function createButton(name, text, position, callback)
    local button = Instance.new("TextButton")
    button.Name = name
    button.Size = UDim2.new(0, 280, 0, 40)
    button.Position = position
    button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    button.BorderSizePixel = 0
    button.Text = text
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 16
    button.Font = Enum.Font.GothamSemibold
    button.AutoButtonColor = false
    button.Parent = mainFrame
    
    -- Efeito hover
    button.MouseEnter:Connect(function()
        if button.Name ~= "AnchorButton" or not anchorEnabled then
            button.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        end
    end)
    
    button.MouseLeave:Connect(function()
        if button.Name == "AnchorButton" and anchorEnabled then
            button.BackgroundColor3 = Color3.fromRGB(60, 120, 60)
        elseif button.Name ~= "AnchorButton" then
            button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        else
            button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        end
    end)
    
    button.MouseButton1Click:Connect(callback)
    
    return button
end

