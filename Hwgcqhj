-- TELEPORT LOGIC
local function teleportToStand()
    if not teleportEnabled then return end
    if not LocalPlayer.Character then return end

    local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = CFrame.new(STAND_POSITION + Vector3.new(0, 2, 0)) -- Teleport to pos1
        wait(0.5) -- Wait to allow for pos2 teleport
        hrp.CFrame = CFrame.new(POS2_POSITION + Vector3.new(0, 2, 0)) -- Teleport to pos2
    end
end

