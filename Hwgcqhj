local function applyFFlags(flags)
    for name, value in pairs(flags) do
        pcall(function()
            setfflag(tostring(name), tostring(value))
        end)
    end
end

local function respawn(plr)
    local char = plr.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Dead) -- Simulate death
        end
        char:ClearAllChildren() -- Clear existing character model
        task.wait(0.5) -- Wait for a moment
        local newChar = Instance.new("Model") -- Create a new character model
        newChar.Parent = Workspace
        plr.Character = newChar
        task.wait() -- Wait again
        plr.Character = char -- Restore the character
        newChar:Destroy() -- Clean up
    end
end

